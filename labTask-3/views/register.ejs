<link rel="stylesheet" href="/style.css">

<div class="admin-banner">
     Register
</div>

<div class="add-container">

    <form action="/register" method="POST" class="add-form">

        <input type="text"
               name="name"
               placeholder="Enter Name"
               required>

        <input type="email"
               name="email"
               placeholder="Enter Email"
               required>

        <input type="password"
               name="password"
               placeholder="Enter Password"
               required>

        <button type="submit">
            Register
        </button>

    </form>

</div>