<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

<!-- HEADER -->
<!-- HEADER -->
<div class="admin-banner">
    <h1>Admin Dashboard</h1>
</div>

<div class="admin-topbar">
    <div></div> <!-- left empty for spacing -->

    <div class="admin-actions-top">
        <a href="/admin/add" class="a-btn">+ Add Product</a>
        <a href="/logout" class="a-btn logout">Logout</a>
    </div>
</div>

<!-- PRODUCTS GRID -->
<div class="admin-grid">

    <% products.forEach(p => { %>

        <div class="admin-card">

            <!-- IMAGE -->
            <div class="admin-img">
                <img src="<%= p.image %>" alt="<%= p.name %>">
            </div>

            <!-- INFO -->
            <div class="admin-info">

                <h3><%= p.name %></h3>

                <p><b>Category:</b> <%= p.category %></p>
                <p><b>Price:</b> Rs <%= p.price %></p>
                <p><b>Rating:</b> ⭐ <%= p.rating %></p>
                <p><b>Stock:</b> <%= p.stock %></p>

                <!-- ACTIONS -->
                <div class="admin-actions">

                   <a href="/admin/edit/<%= p._id %>" class="edit-btn">
    Edit
</a>

                    <a href="/admin/delete/<%= p._id %>" class="delete-btn"
                       onclick="return confirm('Are you sure you want to delete this product?')">
                        Delete
                    </a>

                </div>

            </div>

        </div>

    <% }) %>

</div>

</body>
</html>